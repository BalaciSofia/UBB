@model List<Flight>

@{
    ViewData["Title"] = "Flights";
}

<h2>Available flights</h2>

<p>Date: @Context.Session.GetString("date")</p>
<p>Destination: @Context.Session.GetString("destinationCity")</p>

<table border="1">
    <tr>
        <th>ID</th>
        <th>Date</th>
        <th>Destination</th>
        <th>Available seats</th>
        <th>Action</th>
    </tr>

    @foreach (var flight in Model)
    {
        <tr>
            <td>@flight.getId()</td>
            <td>@flight.getDate().ToString("yyyy-MM-dd")</td>
            <td>@flight.getDestinationCity()</td>
            <td>@flight.getAvaialableSeats()</td>
            <td>
                <form method="post" asp-controller="Main" asp-action="Reserve">
                    <input type="hidden" name="id" value="@flight.getId()" />
                    <input type="hidden" name="type" value="flight" />

                    <button type="submit">Reserve</button>
                </form>
            </td>
        </tr>
    }
</table>

<a asp-controller="Main" asp-action="Home">Back</a>
