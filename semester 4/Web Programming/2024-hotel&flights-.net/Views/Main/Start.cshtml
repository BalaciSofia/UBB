@{
    ViewData["Title"] = "Start";
}

<h2>Begin reservation</h2>

<form method="post" action="/Main/Start">
    <div>
        <label>Name</label>
        <input type="text" name="person" required />
    </div>

    <div>
        <label>Date</label>
        <input type="date" name="date" required />
    </div>

    <div>
        <label>Destination city</label>
        <input type="text" name="destinationCity" required />
    </div>

    <button type="submit">Begin Reservation</button>
</form>