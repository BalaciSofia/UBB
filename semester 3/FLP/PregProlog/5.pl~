%se da list neliniara numere si atomi
%sa se determine in ordine inversa toate elementele numerice unice
addend([],E,[E]).
addend([H|T],E,[H|R]):-
    addend(T,E,R).
reverselist([],[]).
reverselist([H|T],R):-
    reverselist(T,R1),
    addend(R1,H,R).
concatenate([H|T],L2,[H|R]):-
    concatenate(T,L2,R).
concatenate([],[H|T],[H|R]):-
    concatenate([],T,R).
concatenate([],[],[]).

inlist([E|_],E).
inlist([_|T],E):-
    inlist(T,E).

delete([H|T],[H|R]):-
    number(H),!,
    delete(T,R).
delete([],[]).
delete([H|T],R):-
    atom(H),!,
    delete(T,R).
delete([H|T],Res):-
    is_list(H),!,
    delete(H,R1),
    delete(T,R),
    concatenate(R1,R,Res).

unique([H|T],Acc,R):-
    inlist(Acc,H),
    unique(T,Acc,R).
unique([H|T],Acc,[H|R]):-
    not(inlist(Acc,H)),
    Acc1=[H|Acc],
    unique(T,Acc1,R).
unique([],_,[]).
problema(L,R):-
    delete(L,R1),
    unique(R1,[],R2),
    reverselist(R2,R).
