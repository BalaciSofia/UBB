%se da o lista de nr si adomi,sa se stearga toate elementele pare
%sa se dubleze numerele ramase  si cmmmc a elementelor numerice

stergepare([],[]).
stergepare([H|T],[H|R]):-
    not(number(H)),
    stergepare(T,R).
stergepare([H|T],R):-
    number(H),
    0 is H mod 2,
    stergepare(T,R).
stergepare([H|T],[H|R]):-
    number(H),
    1 is H mod 2,
    stergepare(T,R).

dubleaza([],[]).
dubleaza([H|T],[H|R]):-
    not(number(H)),
    dubleaza(T,R).
dubleaza([H|T],[H,H|R]):-
    number(H),
    dubleaza(T,R).

gcd(A,B,R):-
    A > B,
    A1 is A-B,
    gcd(A1,B,R).
gcd(A,B,R):-
    B > A,
    B1 is B-A,
    gcd(A,B1,R).
gcd(A,B,R):-
    A =:= B,
    R = A.

cmmmc(A,B,R):-
    M is A*B,
    gcd(A,B,G),
    R is M/G.

cmmmclista([H|T],Prev,R):-
    number(H),
    cmmmc(H,Prev,Prev1),
    cmmmclista(T,Prev1,R).
cmmmclista([H|T],Prev,R):-
    not(number(H)),
    cmmmclista(T,Prev,R).
cmmmclista([],Prev,Prev).

cmmmclistawrapper([H|T],R):-
    cmmmclista([H|T],H,R).

problema(L,[R1|R3]):-
    stergepare(L,R1),
    dubleaza(R1,R2),
    cmmmclistawrapper(R2,R3).
