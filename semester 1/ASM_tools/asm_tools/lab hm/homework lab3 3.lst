     1                                  bits 32 ; assembling for the 32 bits architecture
     2                                  
     3                                  ; declare the EntryPoint (a label defining the very first instruction of the program)
     4                                  global start        
     5                                  
     6                                  ; declare external functions needed by our program
     7                                  extern exit               ; tell nasm that exit exists even if we won't be defining it
     8                                  import exit msvcrt.dll    ; exit is a function that ends the calling process. It is defined in msvcrt.dll
     9                                                            ; msvcrt.dll contains exit, printf and all the other important C-runtime specific functions
    10                                  
    11                                  ; our data is declared here (the variables needed by our program)
    12                                  segment data use32 class=data
    13                                      ; ...
    14 00000000 04                          b db 4
    15 00000001 0A00                        a dw 10
    16 00000003 05000000                    e dd 5
    17 00000007 BC02000000000000            x dq 700
    18                                  ;x-b+8+(2*a-b)/(b*b)+e; 710
    19                                  ;a-word; b-byte; e-doubleword; x-qword unsigned
    20                                  ; our code starts here
    21                                  segment code use32 class=code
    22                                      start:
    23 00000000 66BB0000                        mov bx,0
    24 00000004 B302                            mov bl,2 ;bl=2
    25 00000006 66A1[01000000]                  mov ax,[a];ax=a
    26 0000000C 66F7E3                          mul bx ;dx:ax=2*a
    27 0000000F 6652                            push dx
    28 00000011 6650                            push ax
    29 00000013 58                              pop eax;eax=2*a
    30 00000014 BB00000000                      mov ebx,0
    31 00000019 8A1D[00000000]                  mov bl,[b]
    32 0000001F 29D8                            sub eax,ebx ;eax=2*a-b
    33 00000021 89C1                            mov ecx,eax ;ecx=eax (retinut) ecx=2*a-b
    34 00000023 B800000000                      mov eax,0
    35 00000028 A0[00000000]                    mov al,[b]
    36 0000002D F6E0                            mul al ;ax=b*b
    37                                          ;ecx/ax 
    38                                          ;div <reg16>; AX ← DX:AX / <reg16>, DX ← DX:AX % <reg16>
    39                                          ;ecx mutat in dx:ax
    40                                          ;ax mutat in bx
    41 0000002F 6689C3                          mov bx,ax;bx=b*b
    42 00000032 51                              push ecx
    43 00000033 6658                            pop ax
    44 00000035 665A                            pop dx
    45 00000037 66F7F3                          div bx
    46                                          ;ax=(2*a-b)/(b*b)
    47 0000003A 8B1D[07000000]                  mov ebx,[x]
    48 00000040 8B15[0B000000]                  mov edx,[x+4];edx:ebx=x
    49 00000046 B900000000                      mov ecx,0
    50 0000004B 8A0D[00000000]                  mov cl,[b]
    51 00000051 F8                              clc
    52                                          ;edx:ebx-    x-
    53                                          ;    ecx     b
    54 00000052 29CB                            sub ebx,ecx
    55 00000054 83DA00                          sbb edx,0
    56 00000057 F8                              clc
    57                                          ;edx:ebx+8  x-b+8
    58 00000058 83C308                          add ebx,8
    59 0000005B 83D200                          adc edx,0
    60 0000005E F8                              clc
    61                                          ;edx:ebx+eax  x-b+8+(2*a-b)/(b*b)
    62 0000005F 01C3                            add ebx,eax 
    63 00000061 83D200                          adc edx,0
    64 00000064 F8                              clc
    65 00000065 8B0D[03000000]                  mov ecx,[e]
    66                                          ;edx:ebx+e   x-b+8+(2*a-b)/(b*b)+e
    67 0000006B 01CB                            add ebx,ecx
    68 0000006D 83D200                          adc edx,0
    69                                          ; result in edx:ebx
    70                                          ; exit(0)
    71 00000070 6A00                            push    dword 0      ; push the parameter for exit onto the stack
