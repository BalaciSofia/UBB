     1                                  bits 32 ; Assembling for the 32-bit architecture
     2                                  
     3                                  global start        
     4                                  
     5                                  ; Declare external functions needed by our program
     6                                  extern exit, fopen, fclose, fprintf
     7                                  import exit msvcrt.dll
     8                                  import fopen msvcrt.dll
     9                                  import fclose msvcrt.dll
    10                                  import fprintf msvcrt.dll
    11                                  ; Our data is declared here (the variables needed by our program)
    12                                  segment data use32 class=data
    13 00000000 726573756C742E7478-         file_name db "result.txt", 0  ; Filename to be created
    13 00000009 7400               
    14 0000000B 7700                        access_mode db "w", 0         ; File access mode: "w" (write mode)
    15 0000000D FFFFFFFF                    file_descriptor dd -1       
    16 00000011 61732072616520696B-         text db "as rae ik", 0        
    16 0000001A 00                 
    17 0000001B <res 00000100>              output resb 256               
    18                                  ;A file name and a text (defined in the data segment) are given. The text contains lowercase letters and spaces. Replace all the letters on even positions with their position. Create a file with the given name and w
    19                                  ; Our code starts here
    20                                  segment code use32 class=code
    21                                  start:
    22                                      ;Process the text
    23 00000000 8D35[11000000]              lea esi, [text]                 ; esi-address of text
    24 00000006 8D3D[1B000000]              lea edi, [output]               ; edi-address of output
    25 0000000C B900000000                  mov ecx,0                 ;index
    26 00000011 BA00000000                  mov edx,0             
    27                                  
    28                                  process_text:
    29 00000016 8A06                        mov al, byte [esi]              ; al=current character             
    30 00000018 3C00                        cmp al, 0                    ; Check for end of string
    31 0000001A 7418                        je write_to_file             
    32 0000001C 41                          inc ecx
    33 0000001D F7C101000000                test ecx, 1                      ; Test if position is even 
    34 00000023 7405                        jz replace_with_position         ; Jump if even
    35                                      ; If the position is odd, just copy the character
    36 00000025 AA                          stosb                            ; store the character into output (edi address)
    37 00000026 46                          inc esi                          ;next character in text
    38 00000027 42                          inc edx                          ; Increment the byte count
    39 00000028 EBEC                        jmp process_text
    40                                  
    41                                  replace_with_position:
    42                                      ; Convert the position (ECX) to ASCII and store it in output
    43 0000002A 89C8                        mov eax,ecx         ;eax=index
    44 0000002C 83C030                      add eax,'0'                     ;convert index to ascii
    45 0000002F AA                          stosb      ; Store the position (as a character) in output
    46 00000030 46                          inc esi                          ;next character in text
    47 00000031 42                          inc edx  
    48 00000032 EBE2                        jmp process_text
    49                                  write_to_file:
    50                                      ; opening file
    51                                  
    52 00000034 68[0B000000]                push dword access_mode         
    53 00000039 68[00000000]                push dword file_name            
    54 0000003E FF15[00000000]              call [fopen]                    
    55 00000044 83C408                      add esp, 4*2                    
    56 00000047 A3[0D000000]                mov [file_descriptor], eax      
    57                                  
    58                                      ; Check if fopen() has successfully opened the file (EAX != 0)
    59 0000004C 83F800                      cmp eax, 0
    60 0000004F 7426                        je final                        ; If file opening failed (EAX == 0), jump to final section
    61                                      ; write the processed text to the file 
    62 00000051 52                          push edx                         ; Push the number of bytes to write 
    63 00000052 8D05[1B000000]              lea eax, [output]                ; eax=address of output
    64 00000058 50                          push eax                         
    65 00000059 FF35[0D000000]              push dword [file_descriptor]     
    66 0000005F FF15[00000000]              call [fprintf]                    ; Write the data to the file
    67 00000065 83C40C                      add esp, 12                      
    68                                  
    69                                      ;close file
    70 00000068 FF35[0D000000]              push dword [file_descriptor]     
    71 0000006E FF15[00000000]              call [fclose]                    
    72 00000074 83C404                      add esp, 4                      
    73                                  
    74                                  final:
    75                                    
    76 00000077 6A00                        push dword 0                     ; Push exit code (0 for success)
    77 00000079 FF15[00000000]              call [exit]                      ; Call exit to terminate the program
