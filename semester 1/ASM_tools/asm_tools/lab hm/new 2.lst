    15 00000000 1000                        y dw 16
    16 00000002 0D00                        z dw 13
    17 00000004 1100                        SI_val dw 17
    18 00000006 0F00                        DX_val dw 15
    19 00000008 1200                        AX_val dw 18 
    20                                  
    21                                  ; our code starts here
    22                                  segment code use32 class=code
