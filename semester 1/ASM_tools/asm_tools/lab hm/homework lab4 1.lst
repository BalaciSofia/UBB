     1                                  bits 32 ; assembling for the 32 bits architecture
     2                                  
     3                                  ; declare the EntryPoint (a label defining the very first instruction of the program)
     4                                  global start        
     5                                  
     6                                  ; declare external functions needed by our program
     7                                  extern exit               ; tell nasm that exit exists even if we won't be defining it
     8                                  import exit msvcrt.dll    ; exit is a function that ends the calling process. It is defined in msvcrt.dll
     9                                                            ; msvcrt.dll contains exit, printf and all the other important C-runtime specific functions
    10                                  
    11                                  ; our data is declared here (the variables needed by our program)
    12                                  segment data use32 class=data
    13                                          ;5432109876543210
    14 00000000 5777                        A dw 0111011101010111b
    15 00000002 BE9B                        B dw 1001101110111110b
    16 00000004 <res 00000004>              C resd 1
    17                                      ;=>0000000000000000 , 3>1011101 , 2>111, 1>101010
    18                                  ;Given the words A and B, compute the doubleword C as follows:
    19                                  ;>the bits 0-5 of C are the same as the bits 3-8 of A
    20                                  ;>the bits 6-8 of C are the same as the bits 2-4 of B
    21                                  ;>the bits 9-15 of C are the same as the bits 6-12 of A
    22                                  ;>the bits 16-31 of C have the value 0
    23                                  segment code use32 class=code
    24                                      start:
    25 00000000 BB00000000                      mov ebx,0
    26 00000005 66A1[00000000]                  mov ax,[A]
    27 0000000B 6625F801                        and ax,0000000111111000b
    28 0000000F 66C1C803                        ror ax,3
    29 00000013 6609C3                          or bx,ax
    30 00000016 66A1[02000000]                  mov ax,[B]
    31 0000001C 6683E01C                        and ax,0000000000011100b
    32 00000020 66C1C004                        rol ax,4
    33 00000024 6609C3                          or bx,ax
    34 00000027 66A1[00000000]                  mov ax,[A]
    35 0000002D 6625C01F                        and ax,0001111111000000b
    36 00000031 66C1C003                        rol ax,3
    37 00000035 6609C3                          or bx,ax
    38 00000038 891D[04000000]                  mov [C],ebx
    39                                          ; exit(0)
    40 0000003E 6A00                            push    dword 0      ; push the parameter for exit onto the stack
    41 00000040 FF15[00000000]                  call    [exit]       ; call exit to terminate the program
