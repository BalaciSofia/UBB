    12 00000009 206D756C7465206361-
    12 00000012 70616320726F7375   
    13                                      l equ $-s
    14 0000001A 257300                      format db "%s",0
    15                                  ;Being given a string of bytes representing a text (succession of words separated by spaces), determine which words are palindromes (meaning may be interpreted the same way in either forward or reverse direction); e
    16                                  ; our code starts here
    17                                  segment code use32 class=code
    18                                      start:
    19                                          ; ...
    20 00000000 B91A000000                      mov ecx,l
    21 00000005 BE00000000                      mov esi,0
    22 0000000A BF00000000                      mov edi,0
    23 0000000F BB00000000                      mov ebx,0
    24                                          next:
    25 00000014 80BE[00000000]20                    cmp byte [s+esi],' '
    26 0000001B 7420                                    je next_word; if s+esi==' ' next word
    27                                              ;else
    28 0000001D 80BE[00000000]00                    cmp byte [s+esi], 0  ; end of string check
    29 00000024 7440                                    je done
    30 00000026 89F7                                mov edi,esi ;edi has the adress where the word starts
    31                                              
    32                                                  find_end:;loop until we find the end of the word
    33 00000028 80BE[00000000]20                            cmp byte[s+esi],' '
    34 0000002F 740F                                        je check_palindrome ;if it s the end of  the word we check if is palindrom
    35 00000031 80BE[00000000]00                            cmp byte [s+esi], 0     ; end of string check
    36 00000038 7406                                        je check_palindrome
    37 0000003A 46                                          inc esi;next charachter
    38 0000003B EBEB                                        jmp find_end
    39                                              next_word:
    40 0000003D 46                                      inc esi
    41 0000003E EBD4                                    jmp next
    42                                              check_palindrome:
    43 00000040 4E                                      dec esi ;esi is dec bc the poz of it is at the space not the last character of the word
    44 00000041 89FA                                    mov edx,edi ;edx has the strat adress of word
    45                                                  check:
    46 00000043 8A82[00000000]                              mov al,[s+edx]
    47 00000049 8A8E[00000000]                              mov cl,[s+esi]
    48 0000004F 38C8                                        cmp al,cl;compare character first last, second second last and so on
    49 00000051 7507                                        jne not_palindrome;if they not equal the word is not palindrom
    50 00000053 42                                          inc edx ;first->second charachter
    51 00000054 4E                                          dec esi ;last->second last charachter
    52 00000055 39F2                                        cmp edx,esi ;compare the indexes
    53 00000057 7CEA                                        jl check ;if edx<esi continue to check 
    54                                                      ;else
    55                                             
    56                                                      
    57 00000059 43                                          inc ebx;which stores the number of palindrom words
    58                                              not_palindrome:
    59 0000005A 80BE[00000000]00                        cmp byte[s+esi],0;check if the string ended
    60 00000061 7403                                    je done;if ended end program
    61                                                  ;else continue
    62 00000063 46                                      inc esi
    63 00000064 EBAE                                    jmp next
    64                                          done:
