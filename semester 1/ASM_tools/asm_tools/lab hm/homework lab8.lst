     1                                  bits 32 ; assembling for the 32 bits architecture
     2                                  
     3                                  ; declare the EntryPoint (a label defining the very first instruction of the program)
     4                                  global start        
     5                                  
     6                                  ; declare external functions needed by our program
     7                                  extern exit,printf,scanf
     8                                  import printf msvcrt.dll
     9                                  import scanf msvcrt.dll
    10                                                 ; tell nasm that exit exists even if we won't be defining it
    11                                  import exit msvcrt.dll    ; exit is a function that ends the calling process. It is defined in msvcrt.dll
    12                                                            ; msvcrt.dll contains exit, printf and all the other important C-runtime specific functions
    13                                  
    14                                  ; our data is declared here (the variables needed by our program)
    15                                  segment data use32 class=data
    16 00000000 00000000                    a dd 0
    17 00000004 00000000                    b dd 0
    18 00000008 2578000000000000            formata dd "%x",0
    19 00000010 2578000000000000            formatb dd "%x",0
    20 00000018 73756D3A00                  message db "sum:",0
    21 0000001D 646966666572656E63-         message2 db "difference:",0
    21 00000026 653A00             
    22                                  ;Read two doublewords a and b in base 16 from the keyboard. Display the sum of the low parts of the two numbers and the difference between the high parts of the two numbers in base 16 Example:
    23                                  ;a = 00101A35h
    24                                  ;b = 00023219h
    25                                  ;sum = 4C4Eh
    26                                  ;difference = Eh
    27                                  ; our code starts here
    28                                  segment code use32 class=code
    29                                      start:
    30                                          ; ...
    31 00000000 68[00000000]                    push dword a
    32 00000005 68[08000000]                    push dword formata
    33 0000000A FF15[00000000]                  call [scanf]
    34 00000010 83C408                          add esp,4*2
    35                                          
    36 00000013 A1[00000000]                    mov eax,[a]
    37 00000018 25FFFF0000                      and eax,0000FFFFh
    38 0000001D 8B1D[00000000]                  mov ebx,[a]
    39 00000023 C1EB10                          shr ebx,16
    40                                          
    41 00000026 68[04000000]                    push dword b
    42 0000002B 68[10000000]                    push dword formatb
    43 00000030 FF15[00000000]                  call [scanf]
    44 00000036 83C408                          add esp,4*2
    45                                          
    46 00000039 8B0D[04000000]                  mov ecx,[b]
    47 0000003F 81E1FFFF0000                    and ecx,0000FFFFh
    48 00000045 8B15[04000000]                  mov edx,[b]
    49 0000004B C1EA10                          shr edx,16
    50                                          
    51 0000004E 01C8                            add eax,ecx
    52 00000050 29D3                            sub ebx,edx
    53                                          
    54 00000052 50                              push eax
    55 00000053 68[18000000]                    push dword message
    56 00000058 FF15[00000000]                  call [printf]
    57 0000005E 83C408                          add esp,8
    58                                          
    59 00000061 53                              push ebx
    60 00000062 68[1D000000]                    push dword message2
    61 00000067 FF15[00000000]                  call [printf]
    62 0000006D 83C408                          add esp,8
    63                                          
    64                                          ; exit(0)
    65 00000070 6A00                            push    dword 0      ; push the parameter for exit onto the stack
    66 00000072 FF15[00000000]                  call    [exit]       ; call exit to terminate the program
